# Copy this file to .env.local for local testing, and set the same
# values in Vercel: Project Settings → Environment Variables.

# Find these in Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://ezgjpfeufrbzexdlkqnt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-your-anon-public-key-here

